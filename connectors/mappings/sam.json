{
    "$schema": "../connector-schema.json",
    "name": "PVA TePla SAM TIFF",
    "version": "1.0.0",
    "description": "Maps stable TIFF metadata from PVA TePla SAM samples to FAMH v1.1. Standard acoustic-microscopy fields are intentionally limited to explicit SAM context until the FAMH vocabulary is extended.",
    "targetSchemaVersion": "1.1",
    "mappings": [
        {
            "source": {
                "type": "runtime",
                "field": "image-file-name"
            },
            "target": "/General Section/File Name",
            "description": "Use the current input image filename."
        },
        {
            "source": {
                "type": "runtime",
                "field": "mapping-timestamp"
            },
            "target": "/General Section/Time Stamp",
            "description": "Use the UTC timestamp generated for the current mapping invocation."
        },
        {
            "source": {
                "type": "constant",
                "value": "PVA TePla SAM300"
            },
            "target": "/General Section/Tool Name",
            "description": "The SAM300 instrument identifier is present in every representative sample filename; confirm this inferred tool name in the review sidecar."
        },
        {
            "source": {
                "type": "constant",
                "value": "SAM"
            },
            "target": "/General Section/Method",
            "description": "Scanning Acoustic Microscopy context supplied for these samples."
        },
        {
            "source": {
                "type": "tiff-tag",
                "id": 256,
                "name": "ImageWidth"
            },
            "target": "/General Section/Image Width/Value",
            "description": "TIFF tag 256: image width in pixels."
        },
        {
            "source": {
                "type": "constant",
                "value": "px"
            },
            "target": "/General Section/Image Width/Unit",
            "description": "Image Width unit is pixels."
        },
        {
            "source": {
                "type": "tiff-tag",
                "id": 257,
                "name": "ImageLength"
            },
            "target": "/General Section/Image Height/Value",
            "description": "TIFF tag 257: image height in pixels."
        },
        {
            "source": {
                "type": "constant",
                "value": "px"
            },
            "target": "/General Section/Image Height/Unit",
            "description": "Image Height unit is pixels."
        },
        {
            "source": {
                "type": "tiff-tag",
                "id": 258,
                "name": "BitsPerSample"
            },
            "target": "/General Section/Bit Depth",
            "description": "TIFF tag 258: 8 bits per sample in all representative samples."
        },
        {
            "source": {
                "type": "tiff-tag",
                "id": 271,
                "name": "Make"
            },
            "target": "/General Section/Manufacturer",
            "description": "TIFF tag 271: PVA Tepla Analytical Systems."
        },
        {
            "source": {
                "type": "tiff-tag",
                "id": 262,
                "name": "PhotometricInterpretation"
            },
            "transform": {
                "id": "photometric-to-color-mode",
                "primaryInput": "value"
            },
            "target": "/General Section/Color Mode",
            "description": "TIFF tag 262: convert indexed/palette photometric interpretation to FAMH Color Mode."
        },
        {
            "source": {
                "type": "tiff-tag",
                "id": 282,
                "name": "XResolution"
            },
            "transform": {
                "id": "resolution-to-nm-per-px",
                "primaryInput": "resolution",
                "inputs": {
                    "resolution_unit": {
                        "type": "tiff-tag",
                        "id": 296,
                        "name": "ResolutionUnit"
                    }
                }
            },
            "target": "/General Section/Pixel Width/Value",
            "description": "TIFF tags 282 and 296: convert XResolution to nanometres per pixel."
        },
        {
            "source": {
                "type": "constant",
                "value": "nm"
            },
            "target": "/General Section/Pixel Width/Unit",
            "description": "Pixel Width unit is nanometres."
        },
        {
            "source": {
                "type": "tiff-tag",
                "id": 283,
                "name": "YResolution"
            },
            "transform": {
                "id": "resolution-to-nm-per-px",
                "primaryInput": "resolution",
                "inputs": {
                    "resolution_unit": {
                        "type": "tiff-tag",
                        "id": 296,
                        "name": "ResolutionUnit"
                    }
                }
            },
            "target": "/General Section/Pixel Height/Value",
            "description": "TIFF tags 283 and 296: convert YResolution to nanometres per pixel."
        },
        {
            "source": {
                "type": "constant",
                "value": "nm"
            },
            "target": "/General Section/Pixel Height/Unit",
            "description": "Pixel Height unit is nanometres."
        },
        {
            "source": {
                "type": "constant",
                "value": "SAM"
            },
            "target": "/Method Specific/Scanning Acoustic Microscopy/Modality",
            "description": "Provisional method-specific context required to materialize the FAMH Method Specific section; review the vocabulary decision in the sidecar."
        }
    ]
}